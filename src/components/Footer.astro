---
import { siteConfig } from "../data/config";

const showJewelry = siteConfig.features.showJewelry;

const footerLinks = {
  diamonds: [
    { href: "/diamonds/", label: "All Diamonds" },
    { href: "/diamonds/?origin=Natural", label: "Natural Diamonds" },
    { href: "/diamonds/?origin=Lab-Grown", label: "Lab-Grown Diamonds" },
  ],
  education: [
    { href: "/education/4cs/", label: "The 4Cs" },
    { href: "/education/gia-certification/", label: "GIA Certification" },
    { href: "/education/igi-certification/", label: "IGI Certification" },
    { href: "/education/natural-vs-lab-grown/", label: "Natural vs Lab-Grown" },
  ],
  company: [
    { href: "/about/", label: "About Us" },
    { href: "/contact/", label: "Contact" },
    { href: "/privacy-policy/", label: "Privacy Policy" },
    { href: "/terms/", label: "Terms & Conditions" },
  ],
};

if (showJewelry) {
  footerLinks.company.splice(1, 0, { href: "/jewelry/", label: "Jewelry" });
}
---

<footer class="bg-primary-dark text-white">
  <!-- Trust Badges Strip -->
  <div class="border-b border-white/10">
    <div class="container-luxe py-8 flex flex-wrap items-center justify-center gap-8 lg:gap-16">
      <div class="flex items-center gap-3 text-body-sm opacity-80">
        <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
        </svg>
        <span>GIA Certified</span>
      </div>
      <div class="flex items-center gap-3 text-body-sm opacity-80">
        <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
        </svg>
        <span>IGI Certified</span>
      </div>
      <div class="flex items-center gap-3 text-body-sm opacity-80">
        <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
        </svg>
        <span>Sourced from Surat, India</span>
      </div>
      <div class="flex items-center gap-3 text-body-sm opacity-80">
        <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 24 24">
          <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zm6.93 6h-2.95a15.65 15.65 0 00-1.38-3.56A8.03 8.03 0 0118.92 8zM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96zM4.26 14C4.1 13.36 4 12.69 4 12s.1-1.36.26-2h3.38c-.08.66-.14 1.32-.14 2 0 .68.06 1.34.14 2H4.26zm.82 2h2.95c.32 1.25.78 2.45 1.38 3.56A7.987 7.987 0 015.08 16zm2.95-8H5.08a7.987 7.987 0 014.33-3.56A15.65 15.65 0 008.03 8zM12 19.96c-.83-1.2-1.48-2.53-1.91-3.96h3.82c-.43 1.43-1.08 2.76-1.91 3.96zM14.34 14H9.66c-.09-.66-.16-1.32-.16-2 0-.68.07-1.35.16-2h4.68c.09.65.16 1.32.16 2 0 .68-.07 1.34-.16 2zm.25 5.56c.6-1.11 1.06-2.31 1.38-3.56h2.95a8.03 8.03 0 01-4.33 3.56zM16.36 14c.08-.66.14-1.32.14-2 0-.68-.06-1.34-.14-2h3.38c.16.64.26 1.31.26 2s-.1 1.36-.26 2h-3.38z"/>
        </svg>
        <span>International Buyers Welcome</span>
      </div>
    </div>
  </div>

  <!-- Main Footer Content -->
  <div class="container-luxe py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">
      <!-- Brand Column -->
      <div class="lg:col-span-1">
        <a href="/" class="inline-block mb-6">
          <div class="flex flex-col items-start leading-none">
            <span class="font-serif text-[28px] font-medium tracking-[0.04em] text-accent" style="font-family: var(--font-serif);">NOVVA</span>
            <span class="text-[10px] font-bold tracking-[0.35em] uppercase text-white/80" style="font-family: var(--font-sans);">DIAMONDS</span>
          </div>
        </a>
        <p class="text-body-sm text-white/60 mb-6 max-w-[280px]">
          Premium certified loose diamonds — Natural & Lab-Grown — sourced directly from Surat, the diamond capital of the world.
        </p>
        <!-- Social Links -->
        <div class="flex items-center gap-4">
          <a
            href={siteConfig.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center hover:border-accent hover:text-accent transition-colors"
            aria-label="Instagram"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          </a>
          <a
            href={siteConfig.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center hover:border-accent hover:text-accent transition-colors"
            aria-label="Facebook"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a
            href={siteConfig.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center hover:border-accent hover:text-accent transition-colors"
            aria-label="LinkedIn"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Diamonds Column -->
      <div>
        <h4 class="text-accent mb-6">Diamonds</h4>
        <ul class="space-y-3">
          {
            footerLinks.diamonds.map((link) => (
              <li>
                <a href={link.href} class="text-body-sm text-white/60 hover:text-accent transition-colors">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Education Column -->
      <div>
        <h4 class="text-accent mb-6">Education</h4>
        <ul class="space-y-3">
          {
            footerLinks.education.map((link) => (
              <li>
                <a href={link.href} class="text-body-sm text-white/60 hover:text-accent transition-colors">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Company Column -->
      <div>
        <h4 class="text-accent mb-6">Company</h4>
        <ul class="space-y-3">
          {
            footerLinks.company.map((link) => (
              <li>
                <a href={link.href} class="text-body-sm text-white/60 hover:text-accent transition-colors">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>

        <div class="mt-8">
          <h4 class="text-accent mb-4">Reach Us</h4>
          <a
            href={`https://wa.me/${siteConfig.whatsapp.number.replace(/[^0-9]/g, "")}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-body-sm text-white/60 hover:text-whatsapp transition-colors"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            {siteConfig.phone}
          </a>
          <a
            href={`mailto:${siteConfig.email}`}
            class="flex items-center gap-2 text-body-sm text-white/60 hover:text-accent transition-colors mt-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            {siteConfig.email}
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-white/10">
    <div class="container-luxe py-6 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-caption text-white/40">
        © {new Date().getFullYear()} {siteConfig.name}. All rights reserved.
      </p>
      <p class="text-caption text-white/40">
        Surat, India — Diamond Capital of the World
      </p>
    </div>
  </div>
</footer>
