---
import { siteConfig } from "../data/config";

const currentPath = Astro.url.pathname;
const showJewelry = siteConfig.features.showJewelry;

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/diamonds/", label: "Diamonds" },
  { href: "/education/", label: "Education" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
];

if (showJewelry) {
  navLinks.splice(2, 0, { href: "/jewelry/", label: "Jewelry" });
}
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-[#1E2E23]"
>
  <nav class="container-luxe flex items-center justify-between h-20 lg:h-24">
    <!-- Logo -->
    <a href="/" class="flex items-center group" id="nav-logo">
      <img
        src="/novva_logo.jpeg"
        alt="Novva Diamonds Logo"
        class="h-12 lg:h-16 w-auto object-contain"
      />
    </a>

    <!-- Desktop Nav -->
    <div class="hidden lg:flex items-center gap-10" id="desktop-nav">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "text-label-md transition-colors duration-200",
              currentPath === link.href
                ? "text-accent"
                : "text-white/90 hover:text-accent",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <!-- Desktop Right Actions -->
    <div class="hidden lg:flex items-center gap-6" id="nav-actions">
      <!-- Theme Toggle -->
      <button
        id="theme-toggle"
        class="text-white/90 hover:text-accent transition-colors cursor-pointer p-2 rounded-full hover:bg-white/10"
        aria-label="Toggle theme"
        type="button"
      >
        <!-- Sun icon (shows in dark mode) -->
        <svg id="theme-toggle-light-icon" class="hidden w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon icon (shows in light mode) -->
        <svg id="theme-toggle-dark-icon" class="hidden w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Currency Selector -->
      <div class="relative" id="currency-selector">
        <button
          id="currency-btn"
          class="flex items-center gap-2 text-body-sm text-white/90 hover:text-accent transition-colors cursor-pointer"
          aria-label="Select currency"
          type="button"
        >
          <span id="currency-flag">🇺🇸</span>
          <span id="currency-code" class="text-label-md">USD</span>
          <svg class="w-3 h-3 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div
          id="currency-dropdown"
          class="absolute right-0 top-full mt-2 bg-[#1E2E23] border border-white/10 rounded-md shadow-elevated py-2 min-w-[180px] opacity-0 invisible transition-all duration-200 z-50"
        >
          {
            siteConfig.currencies.map((currency) => (
              <button
                class="currency-option flex items-center gap-3 w-full px-4 py-2.5 text-body-sm hover:bg-white/10 transition-colors text-left cursor-pointer text-white"
                data-code={currency.code}
                data-flag={currency.flag}
                data-symbol={currency.symbol}
                type="button"
              >
                <span class="text-lg">{currency.flag}</span>
                <span class="font-semibold">{currency.code}</span>
                <span class="text-white/60 text-caption">{currency.name}</span>
              </button>
            ))
          }
        </div>
      </div>

      <!-- WhatsApp CTA -->
      <a
        href={`https://wa.me/${siteConfig.whatsapp.number.replace(/[^0-9]/g, "")}?text=${encodeURIComponent(siteConfig.whatsapp.defaultMessage)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-whatsapp !h-11 !min-w-0 !px-5 !text-[11px]"
        id="nav-whatsapp-cta"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        WhatsApp
      </a>
    </div>

    <!-- Mobile Hamburger -->
    <button
      id="mobile-menu-btn"
      class="lg:hidden flex flex-col gap-1.5 p-2 cursor-pointer"
      aria-label="Open menu"
      type="button"
    >
      <span class="hamburger-line block w-6 h-0.5 bg-white transition-all duration-300"></span>
      <span class="hamburger-line block w-6 h-0.5 bg-white transition-all duration-300"></span>
      <span class="hamburger-line block w-4 h-0.5 bg-white transition-all duration-300 ml-auto"></span>
    </button>
  </nav>

  <!-- Mobile Menu Overlay -->
  <div
    id="mobile-menu"
    class="fixed inset-0 bg-[#1E2E23] z-50 lg:hidden opacity-0 invisible transition-all duration-300 flex flex-col text-white"
  >
    <div class="flex items-center justify-between h-20 px-4 sm:px-6">
      <a href="/" class="flex items-center">
        <img src="/novva_logo.jpeg" alt="Novva Diamonds Logo" class="h-12 w-auto object-contain" />
      </a>
      <button id="mobile-menu-close" class="p-2 cursor-pointer text-white/90 hover:text-accent" aria-label="Close menu" type="button">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <nav class="flex flex-col items-center justify-center flex-1 gap-8">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "text-headline-md transition-colors duration-200",
              currentPath === link.href ? "text-accent" : "text-white/90 hover:text-accent",
            ]}
          >
            {link.label}
          </a>
        ))
      }

      <!-- Mobile Theme Toggle -->
      <button
        id="mobile-theme-toggle"
        class="flex items-center gap-2 text-headline-md transition-colors duration-200 text-white/90 hover:text-accent cursor-pointer"
        aria-label="Toggle theme"
        type="button"
      >
        <span id="mobile-theme-text">Dark Mode</span>
      </button>

      <!-- Mobile Currency Selector -->
      <div class="flex items-center gap-3 mt-4">
        {
          siteConfig.currencies.slice(0, 4).map((currency) => (
            <button
              class="currency-option-mobile chip !px-3 !py-2 !bg-white/10 !text-white hover:!bg-white/20"
              data-code={currency.code}
              data-flag={currency.flag}
              data-symbol={currency.symbol}
              type="button"
            >
              {currency.flag} {currency.code}
            </button>
          ))
        }
      </div>

      <a
        href={`https://wa.me/${siteConfig.whatsapp.number.replace(/[^0-9]/g, "")}?text=${encodeURIComponent(siteConfig.whatsapp.defaultMessage)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-whatsapp mt-4"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Chat on WhatsApp
      </a>
    </nav>
  </div>
</header>

<!-- Spacer for fixed header -->
<div class="h-20 lg:h-24"></div>

<script>
  // ─── Header scroll behavior ───
  const header = document.getElementById("site-header");
  let lastScroll = 0;

  window.addEventListener("scroll", () => {
    const currentScroll = window.scrollY;

    if (currentScroll > 50) {
      header?.classList.add("shadow-subtle", "backdrop-blur-md");
    } else {
      header?.classList.remove("shadow-subtle", "backdrop-blur-md");
    }

    lastScroll = currentScroll;
  });

  // ─── Theme Toggle ───
  const themeToggleBtn = document.getElementById("theme-toggle");
  const mobileThemeToggleBtn = document.getElementById("mobile-theme-toggle");
  const themeToggleDarkIcon = document.getElementById("theme-toggle-dark-icon");
  const themeToggleLightIcon = document.getElementById("theme-toggle-light-icon");
  const mobileThemeText = document.getElementById("mobile-theme-text");

  // Change the icons based on the current theme
  function updateThemeUI() {
    if (document.documentElement.classList.contains("dark")) {
      themeToggleLightIcon?.classList.remove("hidden");
      themeToggleDarkIcon?.classList.add("hidden");
      if (mobileThemeText) mobileThemeText.textContent = "Light Mode";
    } else {
      themeToggleLightIcon?.classList.add("hidden");
      themeToggleDarkIcon?.classList.remove("hidden");
      if (mobileThemeText) mobileThemeText.textContent = "Dark Mode";
    }
  }

  // Initialize UI based on script applied in Layout.astro
  updateThemeUI();

  function toggleTheme() {
    // Toggle the .dark class
    document.documentElement.classList.toggle("dark");
    
    // Save preference
    if (document.documentElement.classList.contains("dark")) {
      localStorage.setItem("theme", "dark");
    } else {
      localStorage.setItem("theme", "light");
    }
    
    // Update icons
    updateThemeUI();
  }

  themeToggleBtn?.addEventListener("click", toggleTheme);
  mobileThemeToggleBtn?.addEventListener("click", toggleTheme);

  // ─── Currency Selector ───
  const currencyBtn = document.getElementById("currency-btn");
  const currencyDropdown = document.getElementById("currency-dropdown");
  const currencyFlag = document.getElementById("currency-flag");
  const currencyCode = document.getElementById("currency-code");

  currencyBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    const isOpen = !currencyDropdown?.classList.contains("invisible");
    if (isOpen) {
      currencyDropdown?.classList.add("opacity-0", "invisible");
    } else {
      currencyDropdown?.classList.remove("opacity-0", "invisible");
    }
  });

  document.querySelectorAll(".currency-option").forEach((btn) => {
    btn.addEventListener("click", () => {
      const code = (btn as HTMLElement).dataset.code;
      const flag = (btn as HTMLElement).dataset.flag;
      if (currencyFlag) currencyFlag.textContent = flag || "";
      if (currencyCode) currencyCode.textContent = code || "";
      localStorage.setItem("novva-currency", code || "USD");
      currencyDropdown?.classList.add("opacity-0", "invisible");
    });
  });

  // Close dropdown on outside click
  document.addEventListener("click", () => {
    currencyDropdown?.classList.add("opacity-0", "invisible");
  });

  // ─── Auto-detect currency ───
  function detectCurrency() {
    const saved = localStorage.getItem("novva-currency");
    if (saved) return saved;

    const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
    const tzMap: Record<string, string> = {
      "Asia/Kolkata": "INR", "Asia/Calcutta": "INR",
      "America/New_York": "USD", "America/Chicago": "USD", "America/Denver": "USD", "America/Los_Angeles": "USD",
      "Australia/Sydney": "AUD", "Australia/Melbourne": "AUD", "Australia/Brisbane": "AUD",
      "America/Toronto": "CAD", "America/Vancouver": "CAD",
      "Europe/London": "EUR", "Europe/Paris": "EUR", "Europe/Berlin": "EUR", "Europe/Rome": "EUR",
      "Asia/Almaty": "KZT", "Asia/Aqtobe": "KZT",
    };
    return tzMap[tz] || "USD";
  }

  const detectedCurrency = detectCurrency();
  const currencies = JSON.parse('[{"code":"USD","flag":"🇺🇸"},{"code":"INR","flag":"🇮🇳"},{"code":"AUD","flag":"🇦🇺"},{"code":"CAD","flag":"🇨🇦"},{"code":"EUR","flag":"🇪🇺"},{"code":"KZT","flag":"🇰🇿"}]');
  const found = currencies.find((c: { code: string }) => c.code === detectedCurrency);
  if (found) {
    if (currencyFlag) currencyFlag.textContent = found.flag;
    if (currencyCode) currencyCode.textContent = found.code;
  }

  // ─── Mobile Menu ───
  const mobileMenuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenuClose = document.getElementById("mobile-menu-close");
  const mobileMenu = document.getElementById("mobile-menu");

  function openMobileMenu() {
    mobileMenu?.classList.remove("opacity-0", "invisible");
    document.body.style.overflow = "hidden";
  }

  function closeMobileMenu() {
    mobileMenu?.classList.add("opacity-0", "invisible");
    document.body.style.overflow = "";
  }

  mobileMenuBtn?.addEventListener("click", openMobileMenu);
  mobileMenuClose?.addEventListener("click", closeMobileMenu);

  // Mobile currency
  document.querySelectorAll(".currency-option-mobile").forEach((btn) => {
    btn.addEventListener("click", () => {
      const code = (btn as HTMLElement).dataset.code;
      if (code) {
        localStorage.setItem("novva-currency", code);
        document.querySelectorAll(".currency-option-mobile").forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
      }
    });
  });
</script>
