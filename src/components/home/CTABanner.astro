---
import { siteConfig, getWhatsAppLink } from "../../data/config";

const whatsappUrl = getWhatsAppLink(siteConfig.whatsapp.defaultMessage);
---

<section class="relative py-24 overflow-hidden" id="cta-banner">
  <!-- Dark background with accent gradients -->
  <div class="absolute inset-0 bg-primary"></div>
  <div class="absolute inset-0 bg-gradient-to-r from-primary-dark via-primary to-primary-dark"></div>
  <div class="absolute top-0 left-1/4 w-96 h-96 bg-accent/5 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 right-1/4 w-64 h-64 bg-accent/3 rounded-full blur-2xl"></div>

  <!-- Decorative diamond -->
  <div class="absolute top-1/2 right-[10%] -translate-y-1/2 w-32 h-32 border border-accent/10 rotate-45 hidden lg:block"></div>

  <div class="container-luxe relative z-10 text-center">
    <div class="max-w-2xl mx-auto reveal">
      <span class="overline block mb-4 text-accent/80">Start Your Journey</span>
      <h2 class="text-headline-lg text-white mb-6" style="font-size: clamp(28px, 4.5vw, 44px);">
        Ready to Find Your<br />Perfect Diamond?
      </h2>
      <hr class="divider-gold mx-auto mb-6" />
      <p class="text-body-lg text-white/60 mb-10 max-w-lg mx-auto">
        Connect with our diamond experts on WhatsApp. Share your preferences
        and receive personalized recommendations with today's best prices.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Chat on WhatsApp
        </a>
        <a href="/diamonds/" class="btn btn-secondary !border-white/30 !text-white hover:!bg-white/10">
          Browse Collection
        </a>
      </div>
    </div>
  </div>
</section>
