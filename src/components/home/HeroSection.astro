---
import { siteConfig, getWhatsAppLink } from "../../data/config";

const whatsappUrl = getWhatsAppLink(siteConfig.whatsapp.defaultMessage);
---

<section
  id="hero"
  class="relative min-h-[90vh] flex items-center overflow-hidden"
>
  <!-- Background hero image -->
  <div
    class="absolute inset-0"
    style="background-image: url('/novva_hero_image.jpeg'); background-size: cover; background-position: center; background-repeat: no-repeat;"
  >
  </div>
  <!-- Dark overlay for text readability -->
  <div
    class="absolute inset-0 bg-gradient-to-br from-black/75 via-black/60 to-black/50"
  >
  </div>
  <!-- Bottom dark fade to blend into next section -->
  <div
    class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"
  >
  </div>

  <!-- Decorative diamond shapes -->
  <div
    class="absolute top-20 right-[15%] w-64 h-64 border border-accent/10 rotate-45 animate-hero-entrance"
    style="animation-delay: 0.8s;"
  >
  </div>
  <div
    class="absolute bottom-20 left-[10%] w-40 h-40 border border-accent/5 rotate-45 animate-hero-entrance"
    style="animation-delay: 1s;"
  >
  </div>
  <div
    class="absolute top-[40%] right-[8%] w-20 h-20 border border-accent/10 rotate-45 animate-float"
  >
  </div>

  <!-- Sparkle particles -->
  <div
    class="absolute top-[25%] left-[20%] w-1.5 h-1.5 bg-accent/40 rounded-full"
    style="animation: sparkle 3s ease infinite;"
  >
  </div>
  <div
    class="absolute top-[60%] right-[25%] w-1 h-1 bg-accent/30 rounded-full"
    style="animation: sparkle 4s ease infinite 1s;"
  >
  </div>
  <div
    class="absolute top-[35%] right-[40%] w-2 h-2 bg-accent/20 rounded-full"
    style="animation: sparkle 5s ease infinite 2s;"
  >
  </div>

  <!-- Content -->
  <div
    class="container-luxe relative z-10 py-10 lg:py-16 flex justify-center w-full"
  >
    <div class="max-w-4xl mx-auto flex flex-col items-center text-center">
      <!-- Transparent Hero Image Centered -->
      <!-- <div class="relative w-full flex justify-center items-center mb-6 animate-hero-entrance h-[35vh] lg:h-[45vh]" style="animation-delay: 0.1s;">
        <img src="/hero_image.jpeg" alt="Novva Diamonds" class="w-auto h-full object-contain filter drop-shadow-[0_20px_50px_rgba(0,0,0,0.3)] mix-blend-normal" />
      </div> -->

      <!-- Overline -->
      <div class="animate-hero-text" style="animation-delay: 0.2s;">
        <span class="overline text-accent block mb-6">
          From Surat, India — Diamond Capital of the World
        </span>
      </div>

      <!-- Headline -->
      <h1
        class="text-headline-display text-white mb-6 animate-hero-text leading-tight"
        style="animation-delay: 0.4s; font-size: clamp(32px, 5vw, 50px); line-height: 1.15;"
      >
        Certified Brilliance.<br />
        <span class="text-accent">Delivered Worldwide.</span>
      </h1>

      <!-- Gold divider -->
      <hr class="divider-gold animate-gold-line mx-auto mb-8" />

      <!-- Subheadline -->
      <p
        class="text-body-lg text-white/80 max-w-xl mb-10 animate-hero-text"
        style="animation-delay: 0.6s;"
      >
        Premium Natural &amp; Lab-Grown loose diamonds, individually selected and
        GIA/IGI certified. Trusted by buyers across USA, Australia, Canada,
        Europe, and Kazakhstan.
      </p>

      <!-- CTAs -->
      <div
        class="flex gap-2.5 items-center justify-center animate-hero-text w-full"
        style="animation-delay: 0.8s;"
      >
        <a
          href="/diamonds/"
          class="btn btn-accent !h-11 !min-w-0 !px-4 !text-[11px] flex-1 sm:flex-initial justify-center"
        >
          Explore Diamonds
        </a>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp !h-11 !min-w-0 !px-4 !text-[11px] flex-[1.5] sm:flex-initial justify-center gap-1.5"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
            ></path>
          </svg>
          <span class="hidden sm:inline">Get Today's Best Price</span>
          <span class="sm:hidden">Get Best Price</span>
        </a>
      </div>

      <!-- Trust micro-badges -->
      <div
        class="flex flex-wrap items-center justify-center gap-6 mt-10 animate-hero-text w-full"
        style="animation-delay: 1s;"
      >
        <div class="flex items-center gap-2">
          <div
            class="w-8 h-8 rounded-full bg-accent/20 flex items-center justify-center"
          >
            <svg
              class="w-4 h-4 text-accent"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"
              ></path>
            </svg>
          </div>
          <span class="text-caption text-white/70"
            >GIA &amp; IGI Certified</span
          >
        </div>
        <div class="flex items-center gap-2">
          <div
            class="w-8 h-8 rounded-full bg-accent/20 flex items-center justify-center"
          >
            <svg
              class="w-4 h-4 text-accent"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zm6.93 6h-2.95a15.65 15.65 0 00-1.38-3.56A8.03 8.03 0 0118.92 8zM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96z"
              ></path>
            </svg>
          </div>
          <span class="text-caption text-white/70"
            >Worldwide Delivery</span
          >
        </div>
        <div class="flex items-center gap-2">
          <div
            class="w-8 h-8 rounded-full bg-accent/20 flex items-center justify-center"
          >
            <svg
              class="w-4 h-4 text-accent"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"
              ></path>
            </svg>
          </div>
          <span class="text-caption text-white/70"
            >Natural &amp; Lab-Grown</span
          >
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom fade -->
  <div
    class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-black/80 to-transparent"
  >
  </div>
</section>
