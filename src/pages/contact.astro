---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { siteConfig, getWhatsAppLink } from "../data/config";

const whatsappUrl = getWhatsAppLink(siteConfig.whatsapp.defaultMessage);
---

<Layout
  title="Contact Novva Diamonds — WhatsApp Us | Diamond Inquiry"
  description="Contact Novva Diamonds for diamond inquiries. Chat with us on WhatsApp for personalized diamond recommendations and today's best prices."
>
  <PageHero
    overline="Get in Touch"
    title="Contact Us"
    description="Our diamond experts are ready to help you find the perfect stone. Reach us directly on WhatsApp for the fastest response."
  />

  <!-- Contact Content -->
  <section class="section-padding bg-surface-warm">
    <div class="container-narrow">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">

        <!-- Left: Primary Contact (WhatsApp) -->
        <div class="reveal">
          <div class="bg-surface border border-muted rounded-md p-8 lg:p-10 text-center">
            <div class="w-16 h-16 mx-auto rounded-full bg-whatsapp/10 flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-whatsapp" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </div>
            <h2 class="text-headline-md mb-3" style="font-size: 24px;">Chat on WhatsApp</h2>
            <p class="text-body-md text-text-light mb-6">
              The fastest way to reach us. Get personalized diamond recommendations,
              pricing, and expert guidance — all on WhatsApp.
            </p>
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-whatsapp w-full cursor-pointer"
              id="contact-whatsapp-cta"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              Start a Conversation
            </a>
            <p class="text-caption text-text-light mt-3">{siteConfig.phone}</p>
          </div>
        </div>

        <!-- Right: Additional Info -->
        <div class="reveal stagger-2 space-y-8">
          <!-- Email -->
          <div class="bg-surface border border-muted rounded-md p-6">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-md bg-accent/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-label-md text-on-surface mb-1">Email</h3>
                <a href={`mailto:${siteConfig.email}`} class="text-body-md text-accent hover:underline">{siteConfig.email}</a>
                <p class="text-caption text-text-light mt-1">For formal inquiries and documentation</p>
              </div>
            </div>
          </div>

          <!-- Address -->
          <div class="bg-surface border border-muted rounded-md p-6">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-md bg-accent/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-label-md text-on-surface mb-1">Office</h3>
                <p class="text-body-md text-text-light">{siteConfig.address.full}</p>
              </div>
            </div>
          </div>

          <!-- Business Hours -->
          <div class="bg-surface border border-muted rounded-md p-6">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-md bg-accent/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-label-md text-on-surface mb-1">Business Hours</h3>
                <p class="text-body-sm text-text-light">Monday – Saturday: 10:00 AM – 7:00 PM IST</p>
                <p class="text-body-sm text-text-light">Sunday: Closed</p>
                <p class="text-caption text-text-light mt-2">WhatsApp messages are welcome anytime — we respond within 24 hours.</p>
              </div>
            </div>
          </div>

          <!-- Countries Served -->
          <div class="bg-surface border border-muted rounded-md p-6">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-md bg-accent/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-label-md text-on-surface mb-2">We Serve Buyers In</h3>
                <div class="flex flex-wrap gap-2">
                  {["🇺🇸 USA", "🇦🇺 Australia", "🇨🇦 Canada", "🇪🇺 Europe", "🇰🇿 Kazakhstan", "🇮🇳 India"].map((country) => (
                    <span class="badge">{country}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
