---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import { siteConfig, getWhatsAppLink } from "../../data/config";
import jewelryData from "../../data/jewelry.json";

// Feature flag check — redirect if jewelry is disabled
if (!siteConfig.features.showJewelry) {
  return Astro.redirect("/");
}

const categories = ["Rings", "Pendants", "Earrings", "Bracelets"] as const;
---

<Layout
  title="Diamond Jewelry Collection — Rings, Pendants, Earrings, Bracelets | Novva Diamonds"
  description="Explore our curated diamond jewelry collection. Rings, pendants, earrings, and bracelets crafted with certified diamonds. Inquire via WhatsApp."
>
  <PageHero
    overline="Our Jewelry"
    title="Diamond Jewelry Collection"
    description="Handcrafted jewelry featuring our finest certified diamonds. Each piece is made to order — inquire via WhatsApp for details and pricing."
  />

  <!-- Category Sections -->
  {categories.map((category) => {
    const items = jewelryData.filter((item) => item.category === category);
    return (
      <section class="section-padding bg-surface-warm border-b border-muted" id={`jewelry-${category.toLowerCase()}`}>
        <div class="container-luxe">
          <div class="text-center mb-12 reveal">
            <span class="overline block mb-3">{category}</span>
            <h2 class="text-headline-md" style="font-size: clamp(24px, 3vw, 32px);">{category}</h2>
            <hr class="divider-gold mx-auto mt-4" />
          </div>

          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
            {items.map((item, i) => (
              <article class={`card group reveal stagger-${i + 1}`}>
                <!-- Image -->
                <div class="img-zoom mb-4 aspect-square bg-surface-marble rounded-sm overflow-hidden border border-muted">
                  <div class="w-full h-full flex items-center justify-center bg-white">
                    {item.images && item.images[0] ? (
                      <img 
                        src={item.images[0]} 
                        alt={item.name} 
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        loading="lazy"
                      />
                    ) : (
                      <div class="text-center">
                        <svg class="w-16 h-16 mx-auto text-primary/15 group-hover:text-accent/30 transition-colors" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M19 3H5L2 9l10 12L22 9l-3-6zM9.62 8l1.5-3h1.76l1.5 3H9.62z"/>
                        </svg>
                        <span class="text-overline text-primary/25 mt-1 block text-[10px]">{item.category}</span>
                      </div>
                    )}
                  </div>
                </div>

                <!-- Details -->
                <div class="px-1">
                  <h3 class="text-body-md font-semibold text-on-surface mb-1">{item.name}</h3>
                  <p class="text-caption text-text-light mb-1">{item.materials}</p>
                  <p class="text-body-sm text-text-light mb-4 line-clamp-2">{item.description}</p>

                  <a
                    href={getWhatsAppLink(`Hi, I'm interested in the ${item.name} from Novva Diamonds. Please share details and pricing.`)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-whatsapp !h-9 !min-w-0 w-full !px-3 !text-[10px]"
                  >
                    <svg class="w-3.5 h-3.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                    </svg>
                    Inquire on WhatsApp
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    );
  })}
</Layout>

